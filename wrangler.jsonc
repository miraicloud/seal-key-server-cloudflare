{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seal-key-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 30000
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "NETWORK": "testnet",
    "KEY_SERVER_CONFIG": "{\"mode\":\"open\",\"keyServerObjectId\":\"0x0\"}"
  }
}
